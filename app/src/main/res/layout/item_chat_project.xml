<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_card"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvProjectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Landing Page"
            android:textColor="?attr/themeTextPrimary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvProjectLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_jarvis_chip"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="HTML"
            android:textColor="?attr/themeAccent"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvProjectSnippet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="&lt;!DOCTYPE html&gt; &lt;html&gt; &lt;head&gt;..."
        android:textColor="?attr/themeTextMuted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <TextView
            android:id="@+id/tvProjectDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Today • 12:30 PM"
            android:textColor="?attr/themeTextMuted"
            android:textSize="11sp"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to preview code"
            android:textColor="?attr/themeAccent"
            android:textSize="12sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>
