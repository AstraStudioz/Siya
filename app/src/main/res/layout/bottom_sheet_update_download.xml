<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_jarvis_dock"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="32dp">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_jarvis_chip"
        android:layout_marginBottom="16dp" />

    <!-- Sheet Header -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Install Siya AI Update"
        android:textColor="?attr/themeTextPrimary"
        android:textSize="20sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSheetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose your preferred download channel"
        android:textColor="?attr/themeTextMuted"
        android:textSize="13sp"
        android:fontFamily="sans-serif"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp" />

    <!-- OPTION 1: GitHub Direct In-App Download Card -->
    <LinearLayout
        android:id="@+id/cardGithubDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:padding="16dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_jarvis_icon_square">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_download"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="GitHub Download" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update by ShivuOfc"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In-app direct download &amp; SHA-256 verification"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Download Progress Bar -->
        <ProgressBar
            android:id="@+id/pbDownloadProgress"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:max="100"
            android:progress="0"
            android:visibility="gone"
            android:progressTint="?attr/themeAccent" />

        <!-- Status & Speed Label -->
        <TextView
            android:id="@+id/tvDownloadStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Official release build • Direct in-app install"
            android:textColor="?attr/themeTextMuted"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:layout_marginTop="8dp" />

        <!-- Download / Install / Cancel Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnCancelDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:text="Cancel"
                android:textColor="?attr/themeTextMuted"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnActionGithubDownload"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Download APK"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- OPTION 2: Telegram Channel Post Card (Hidden as requested) -->
    <LinearLayout
        android:id="@+id/cardTelegramDownload"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_jarvis_icon_square">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_social_telegram"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="Telegram Download" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Update via Telegram"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTelegramSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download directly from the Telegram channel post"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnOpenTelegram"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="Open in Telegram"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </LinearLayout>

    <!-- ShivuOfc Custom App Development Advertisement Banner -->
    <LinearLayout
        android:id="@+id/cardDevAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_jarvis_card"
        android:padding="16dp"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_jarvis_icon_square">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_settings"
                    app:tint="?attr/themeAccent"
                    android:contentDescription="Custom App Development" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Need a Custom App Built?"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If you want any type of app developed, you can contact ShivuOfc. Quality apps crafted at affordable prices!"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnContactDev"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:minHeight="48dp"
            android:background="@drawable/bg_jarvis_pill_button"
            android:text="Contact @ShivuOfc on Telegram"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</LinearLayout>
