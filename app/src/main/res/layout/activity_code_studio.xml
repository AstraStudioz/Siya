<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/themeBg">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/headerCodeStudio"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="?attr/themeCardBg"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            app:tint="?attr/themeTextPrimary"
            android:contentDescription="Back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Code Studio"
                android:textColor="?attr/themeTextPrimary"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live coding &amp; Deployment"
                android:textColor="?attr/themeTextMuted"
                android:textSize="11sp"
                android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- New Project Button -->
        <ImageButton
            android:id="@+id/btnNewProject"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_plus"
            app:tint="?attr/themeAccent"
            android:layout_marginEnd="6dp"
            android:contentDescription="New Project" />

        <!-- Export APK Button -->
        <ImageButton
            android:id="@+id/btnExportApk"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_apk_export"
            app:tint="?attr/themeAccent"
            android:layout_marginEnd="6dp"
            android:contentDescription="Export APK" />

        <!-- Edit / Done Toggle Button -->
        <Button
            android:id="@+id/btnToggleEdit"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minHeight="34dp"
            android:text="Edit"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_jarvis_pill_button"
            android:paddingHorizontal="10dp"
            android:layout_marginEnd="6dp" />

        <!-- Download ZIP Button -->
        <ImageButton
            android:id="@+id/btnDownloadZip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_jarvis_icon_square"
            android:src="@drawable/ic_download"
            app:tint="?attr/themeAccent"
            android:contentDescription="Download ZIP" />
    </LinearLayout>

    <!-- Tab Selector (Preview vs Editor vs AI Insights) - 100% Vector Icons, ZERO Emojis -->
    <LinearLayout
        android:id="@+id/layoutTabs"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:background="?attr/themeCardBg"
        android:paddingHorizontal="8dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/headerCodeStudio">

        <TextView
            android:id="@+id/tabLivePreview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Preview"
            android:textColor="?attr/themeAccent"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/bg_tab_selected_bottom"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabCodeEditor"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Editor"
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabAiInsights"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:gravity="center"
            android:text="AI Insights"
            android:textColor="?attr/themeTextMuted"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Main Content Area: Flipped between Live WebView, Editor, AI Insights, and Live Generating Code Box -->
    <FrameLayout
        android:id="@+id/containerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/layoutTabs"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomBar">

        <!-- 1. Live Deployment Preview Container -->
        <LinearLayout
            android:id="@+id/viewLiveDeployment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Simulated Browser Address Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/themeCardBg"
                android:paddingHorizontal="10dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot_green"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#10B981"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:id="@+id/tvLiveUrl"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:background="?attr/themeBg"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp"
                    android:text="https://siya-app.local/live-preview"
                    android:textColor="?attr/themeTextMuted"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnRefreshPreview"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_refresh"
                    app:tint="?attr/themeTextMuted"
                    android:layout_marginStart="6dp"
                    android:contentDescription="Refresh Preview" />
            </LinearLayout>

            <WebView
                android:id="@+id/wvLivePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF" />
        </LinearLayout>

        <!-- 2. Code Editor Container -->
        <LinearLayout
            android:id="@+id/viewCodeEditor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="?attr/themeBg"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/themeCardBg"
                android:paddingHorizontal="12dp">

                <TextView
                    android:id="@+id/tvEditorStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="index.html • HTML/CSS/JS"
                    android:textColor="?attr/themeAccent"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />

                <Button
                    android:id="@+id/btnRunCode"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:minHeight="28dp"
                    android:text="Run"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_jarvis_pill_button"
                    android:paddingHorizontal="12dp" />
            </LinearLayout>

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <EditText
                    android:id="@+id/etCodeEditor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:padding="14dp"
                    android:textColor="?attr/themeTextPrimary"
                    android:textColorHighlight="?attr/themeAccent"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:hint="// Write or generate code here..."
                    android:textColorHint="?attr/themeTextMuted" />
            </ScrollView>
        </LinearLayout>

        <!-- 3. AI Insights & Feature Recommendations Container -->
        <ScrollView
            android:id="@+id/viewAiInsights"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/themeBg"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Project Analysis Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROJECT ANALYSIS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/themeAccent" />

                    <TextView
                        android:id="@+id/tvAiAnalysisOverview"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Single-file interactive web app with embedded CSS styling and JavaScript state management."
                        android:textSize="13sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/themeTextPrimary"
                        android:lineSpacingExtra="2dp"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- Recommended New Features Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_card"
                    android:padding="16dp"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RECOMMENDED NEW FEATURES"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/themeAccent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap any feature to automatically inject and deploy it:"
                        android:textSize="12sp"
                        android:textColor="?attr/themeTextMuted"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="10dp" />

                    <!-- Feature chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/chipRecLocalStorage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add LocalStorage Data Persistence"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextPrimary"
                            android:background="@drawable/bg_jarvis_action_card"
                            android:padding="10dp"
                            android:layout_marginBottom="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipRecAnimations"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add Micro-Interactions &amp; Sound FX"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextPrimary"
                            android:background="@drawable/bg_jarvis_action_card"
                            android:padding="10dp"
                            android:layout_marginBottom="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipRecDarkTheme"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add Light / Dark Mode Toggle"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextPrimary"
                            android:background="@drawable/bg_jarvis_action_card"
                            android:padding="10dp"
                            android:layout_marginBottom="8dp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/chipRecExportJson"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Add One-Click Data Export &amp; Share"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="?attr/themeTextPrimary"
                            android:background="@drawable/bg_jarvis_action_card"
                            android:padding="10dp"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Code Upgrades & Optimizations Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_jarvis_card"
                    android:padding="16dp"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CODE UPGRADES &amp; OPTIMIZATIONS"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="?attr/themeAccent" />

                    <TextView
                        android:id="@+id/tvAiOptimizationTips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Add mobile touch gestures &amp; haptic feedback\n• Ensure full keyboard navigation accessibility\n• Optimize DOM event listeners with debouncing"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="?attr/themeTextMuted"
                        android:lineSpacingExtra="4dp"
                        android:layout_marginTop="8dp" />
                </LinearLayout>

                <!-- Upgrade Action Button -->
                <Button
                    android:id="@+id/btnAiAutoUpgrade"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:text="Upgrade Project with AI"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_jarvis_pill_button"
                    android:textAllCaps="false"
                    android:layout_marginBottom="24dp" />
            </LinearLayout>
        </ScrollView>

        <!-- 4. Live Code Generating Box (Streaming Preview Card) -->
        <LinearLayout
            android:id="@+id/viewGeneratingCodeBox"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#1E1E2E"
            android:padding="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <ProgressBar
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:indeterminate="true"
                    android:indeterminateTint="?attr/themeAccent" />

                <TextView
                    android:id="@+id/tvGeneratingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Siya AI writing code..."
                    android:textColor="#A6ADC8"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:layout_marginStart="10dp" />

                <TextView
                    android:id="@+id/tvGeneratingCharCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 chars"
                    android:textColor="#6C7086"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/svGeneratingCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#181825"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvGeneratingCodeStream"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#CDD6F4"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:text="// Generating project architecture..." />
            </ScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Bottom AI Generation Dock -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/themeCardBg"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Suggestion Chips Horizontal Scroll (ZERO Emojis) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipPortfolio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Portfolio Website"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipGame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canvas Game"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipPython"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Python App"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipCalculator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Calculator"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipDashboard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Analytics Dashboard"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/chipKanban"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Task Kanban"
                    android:textColor="?attr/themeTextPrimary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_jarvis_action_card"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Prompt Input Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etCodePrompt"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_field"
                android:paddingHorizontal="14dp"
                android:hint="Ask Siya to code or update anything..."
                android:textColor="?attr/themeTextPrimary"
                android:textColorHint="?attr/themeTextMuted"
                android:textSize="13sp"
                android:singleLine="true"
                android:imeOptions="actionSend" />

            <ProgressBar
                android:id="@+id/pbGenerating"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminate="true"
                android:visibility="gone"
                android:indeterminateTint="?attr/themeAccent"
                android:layout_marginStart="8dp" />

            <Button
                android:id="@+id/btnGenerateCode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Generate"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_jarvis_pill_button"
                android:paddingHorizontal="14dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
